# Copy to .env (not tracked by Git) and fill in.
# The server address dedicated to this app:
PDAC_IP=203.0.113.10
# Its domain name (the DNS A record must point to PDAC_IP):
PDAC_DOMAIN=pdac.example.org
# Contact address for the Let's Encrypt certificate (expiry notices):
ACME_EMAIL=you@example.org
# Private usage page: open https://<domain>/?stats=<PDAC_STATS_KEY> and enter PDAC_STATS_PASSWORD.
# Any other address shows the normal site. Leave either empty (or the key shorter than 16 characters) to switch the page off.
# Make both with: openssl rand -hex 16
# Anonymous usage is counted either way (no cookies, no IP addresses; see app/R/05_usage.R).
PDAC_STATS_KEY=
PDAC_STATS_PASSWORD=
